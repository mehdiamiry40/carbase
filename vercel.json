{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:deployment",
  "crons": [
    {
      "path": "/api/cron/quote-outbox",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "src/app/api/quote/route.ts": {
      "maxDuration": 30,
      "regions": ["syd1"]
    },
    "src/app/api/cron/quote-outbox/route.ts": {
      "maxDuration": 60,
      "regions": ["syd1"]
    }
  }
}
