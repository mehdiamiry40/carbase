# ── Quote form email delivery ────────────────────────────────────────────
# Sign up free at https://resend.com, create an API key and paste it here.
# Until this is set, quote leads are logged to the server console instead
# of being emailed (the form still works and shows success to visitors).
RESEND_API_KEY=

# The inbox that receives each quote lead.
QUOTE_TO_EMAIL=mehdiamiry40@gmail.com

# The sender address. "onboarding@resend.dev" works out of the box for
# testing (it can only deliver to your own Resend account email). Once you
# verify your domain in Resend, change this to e.g. "Carbase <quotes@carbase.com.au>".
QUOTE_FROM_EMAIL=Carbase Website <onboarding@resend.dev>

# ── SEO ──────────────────────────────────────────────────────────────────
# The canonical public URL of the site (used in sitemap, robots and meta tags).
NEXT_PUBLIC_SITE_URL=https://carbase.com.au
