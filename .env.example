# ── Quote form email delivery ────────────────────────────────────────────
# Sign up free at https://resend.com, create an API key and paste it here.
# Without this key, a successfully staged lead returns 202 for recovery. If
# private staging is also unavailable, the endpoint returns 503.
RESEND_API_KEY=

# Optional override for the private inbox that receives each quote lead. If
# empty or unset, the verified server-side quote destination is used.
QUOTE_TO_EMAIL=mehdiamiry40@gmail.com

# Optional sender override. "onboarding@resend.dev" works for testing (and can
# only deliver to your own Resend account email). Verify a domain before using
# a sender on that domain in production.
QUOTE_FROM_EMAIL=Carbase Website <onboarding@resend.dev>

# Private Vercel Blob store token for the quote outbox. Each validated request
# is staged before Resend is called, then deleted after confirmed email delivery
# or retained for recovery if delivery fails. Create/connect a PRIVATE Blob
# store in Vercel; never expose this value through a NEXT_PUBLIC_ variable.
BLOB_READ_WRITE_TOKEN=

# Vercel Firewall Rate Limiting SDK mode. Production defaults to enforce and
# fails closed unless a published @vercel/firewall rule uses ID "quote-submit".
# Local development defaults to off. Use observe only during staged rollout.
QUOTE_RATE_LIMIT_MODE=enforce

# Vercel Cron sends this value as "Authorization: Bearer <secret>". Use at
# least 32 random bytes and never expose it through a NEXT_PUBLIC_ variable.
CRON_SECRET=

# The outbox cron starts in observe mode. Change to live only after preview
# recovery tests and Resend idempotency verification pass.
QUOTE_OUTBOX_RECOVERY_MODE=observe
# This may be shortened; values above 30 are ignored. Expired records are
# deleted on a subsequent successful cleanup run, not by a storage TTL.
QUOTE_OUTBOX_RETENTION_DAYS=30
QUOTE_OUTBOX_BATCH_SIZE=5
QUOTE_OUTBOX_MAX_ATTEMPTS=5

# ── SEO ──────────────────────────────────────────────────────────────────
# The canonical public URL of the site (used in sitemap, robots and meta tags).
NEXT_PUBLIC_SITE_URL=https://carbase.au

# ── Analytics ────────────────────────────────────────────────────────────
# Optional GA4 measurement ID. When unset, no Google Analytics scripts or
# conversion events are loaded.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
